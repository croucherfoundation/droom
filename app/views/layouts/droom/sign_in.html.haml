!!!
%html{:lang => 'en'}
  %head
    %title
      - if content_for?(:pagetitle)
        = yield :pagetitle
      - else
        = t(:foundation)
      |
      = t(:croucher_foundation)

    = stylesheet_link_tag "croucher_core.css"
    = stylesheet_link_tag "cdr", media: "all"

    = content_for :css
    = content_for :head
    = csrf_meta_tags

    %link{rel: "apple-touch-icon", size: "152x152", href: "/images/apple-touch-icon@2x.png"}
    %link{rel: "apple-touch-icon", size: "120x120", href: "/images/apple-touch-icon@2x.png"}
    %link{rel: "apple-touch-icon", size: "76x76", href: "/images/apple-touch-icon.png"}
    %link{rel: "apple-touch-icon", href: "/images/apple-touch-icon.png"}
    %link{rel: "icon", type: "image/png", href: "/images/favicon.png"}

    - if Rails.env.production?
      %script(async src="https://www.googletagmanager.com/gtag/js?id=UA-38204053-9")
      :javascript
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', 'UA-38204053-9');

    %script(async src="https://www.google.com/recaptcha/enterprise.js?render=#{ENV.fetch('RECAPTCHA_SITE_KEY')}")
  %body
    = hidden_field_tag :user_status, nil, data: {sign_in: "#{user_signed_in?}", tz_enabled: "#{FeatureFlag.enabled?('time-zone-feature', current_user)}"}
    
    .main_sub_navbar_container
      = render :partial => "fragments/navbar"
    
    = render :partial => "droom/users/passwords/password_reset_box"
    
    = yield

    #flashes
      %p.notice= notice
      - if alert.present?
        - unless alert.include?('Please sign in to continue')
          %p.alert= alert

    - if @show_footer
      = render :partial => "fragments/footer"

    = javascript_include_tag "cdr"
    = content_for :js

    = render "droom/shared/symbols"
    = render "layouts/symbols"
 