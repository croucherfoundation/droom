- event ||= false
- group ||= false
- invitation ||= false
- data_for = "user_#{user.id}"
- if group
  - data_for = "user_#{user.id}#{group.id}"

- if can?(:edit, user)
  .menu{:data => {:for => data_for}}
    %ul.actions
      - if invitation
        %li
          = link_to droom.event_invitation_url(invitation.event, invitation), :method => 'delete', :class => 'delete', :data => {:action => "remove", :removed => "#user_#{user.id}#{group.try(:id)}", :confirm => "Are you sure you want to remove the user #{user.name} from invitations?"} do
            %svg
              %use{href: "#trash_symbol"}
            = t(:delete_user_from_invitations)
      - else
        %li
          = link_to droom.edit_user_url(user), :class => 'edit', :data => {:action => "popup", :affected => "#user_#{user.id}#{group.try(:id)}"} do
            %svg
              %use{href: "#edit_symbol"}
            = t(:edit_profile)
        %li
          = link_to droom.edit_user_url(user, view: 'preferences'), :class => 'edit', :data => {:action => "popup", :affected => "#user_#{user.id}#{group.try(:id)}"} do
            %svg
              %use{href: "#edit_symbol"}
            = t(:edit_account)

        - unless user == current_user
          %li
            = link_to droom.user_url(user), :method => 'delete', :class => 'delete', :data => {:action => "remove", :removed => "#user_#{user.id}#{group.try(:id)}", :confirm => t(:confirm_delete_user, :name => user.full_name)} do
              %svg
                %use{href: "#trash_symbol"}
              = t(:delete_user)

        - if !user.confirmed? && can?(:reinvite, user)
          %li
            = link_to droom.reinvite_user_url(user), class: 'edit reinvite', method: 'put', data: {action: "reinvite", confirmation: "reinvited"} do
              %svg
                %use{href: "#edit_symbol"}
              = t(:reinvite)

        - if group && membership = user.membership_of(group)
          %li
            = link_to droom.membership_url(membership), :method => 'delete', :class => 'delete', :data => {:action => "remove", :removed => "#user_#{user.id}#{group.try(:id)}"} do
              %svg
                %use{href: "#trash_symbol"}
              = t(:expel, name: group.name)