- user ||= @user

- if user == current_user
  - title = t :edit_your_profile
- elsif user.new_record?
  - title = t :add_new_user
  - if Droom.use_organisations? && @user.organisation
    - title << [t(:to), " ", user.organisation.name].join(" ")
- else
  - title = t(:edit_profile_of, name: user.name)

#edit_user
  .standard-modal-overlay.active
    .standard-modal-container.active
      %svg.logo
        %use{"xlink:href" => "#croucher_logo"}
      = form_for user, :html => {:class => 'edit user', :autocomplete => false} do |f|
        .container
          %h2
            = title
          .inputs
            = render partial: 'droom/users/edit/user_fields', locals: {f: f, user: user, timezone_id: "profile_timezone"}

        .buttons
          = link_to t(:cancel_edit), '#', :class => 'cancel submit-button'
          - if user == current_user
            = f.submit t(:save_your_profile), class: 'standard-modal-submit'
          - else
            = f.submit t(:save_profile), class: 'standard-modal-submit'

          - if !@user.confirmed? && (admin? || @user.organisation && organisation_admin?(@user.organisation))
            %p.inputs.mt-8
              = f.check_box :send_confirmation, class: "radio"
              = f.label :send_confirmation, class: "radio_label"
