- user ||= @user

#note
  .standard-modal-overlay.active
    .standard-modal-container.active
      %svg.logo.ml-56
        %use{"xlink:href" => "#croucher_logo"}
      = form_for user, :html => {class: 'poppedup'}, data: {remote: true, type: :html} do |f|
        = hidden_field_tag :view, @view
        = hidden_field_tag "user[group_ids][]", nil
        .container
          %h2
            = t(:groups_for, name: user.name)
          .inputs

            - groups = Droom::Group.all
            - if groups.any?
              %div{style: 'width: 100%;'}
                = f.label(:group_ids, class: "important") + ":"
                - groups.each do |group|
                  = check_box_tag "user[group_ids][]", group.id, user.group_ids.include?(group.id), id: "user_group_ids_#{group.id}", class: "checkbox"
                  %label.checkbox_label.mb.pr-10{for: "user_group_ids_#{group.id}"}
                    = group.name
        .buttons
          = render partial: 'droom/users/edit/buttons', locals: {f: f}
