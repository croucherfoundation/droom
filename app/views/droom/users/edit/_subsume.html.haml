- user ||= @user

- title = t(:subsume_user)

#edit_user
  .standard-modal-overlay.active
    .standard-modal-container.active
      = form_for [droom, user], url: merge_user_url(user), method: 'put', :html => {:class => 'edit user', :autocomplete => false} do |f|
        .standard-modal-header
          .standard-modal-close-btn.cursor-pointer
            %svg.standard_close_icon
              %use{"xlink:href" => "#standard_close_symbol"}
          %svg.logo
            %use{"xlink:href" => "#croucher_logo"}
          .container
            %h2
              = title
        .standard-modal-body
          .container
            .inputs
              %p
                You are about to transfer all the applications, awards, grants, screener, interviewer, and organisers of
                %strong
                  = user.name
                into the user you choose below. 
                
                -# Please be careful: the user
                -# = user.name
                -# will vanish completely.
              
              %p.onecol
                %span.col>
                  = f.label :other_id
                  = f.text_field :other_id, placeholder: t('placeholders.user.other_id')

              %p.note 
                Note: The account merging process will be handled by a background job and may take some time to complete.
                
        .standard-modal-footer
          .buttons
            = link_to t(:cancel_edit), '#', :class => 'cancel submit-button'
            = f.submit t(:subsume_user), class: 'croucher-standard-btn inline'
