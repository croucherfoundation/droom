- user ||= @user
- me = user == current_user
- title = me ? t(:edit_your_account) : t(:edit_account_of, name: user.name)

#edit_user
  .standard-modal-overlay.active
    .standard-modal-container.active
      = form_for @user, :html => {:class => 'edit user password custom-validate', :autocomplete => false} do |f|
        .standard-modal-header
          .standard-modal-close-btn.cursor-pointer
            %svg.standard_close_icon
              %use{"xlink:href" => "#standard_close_symbol"}
          %svg.logo
            %use{"xlink:href" => "#croucher_logo"}
          .container
            %h2
              = title
        .standard-modal-body
          .container
            %p
              - if me
                = t :account_emails
              - else
                = t :admin_account_emails
            .inputs
              -# = render "droom/users/edit/emails", f: f, user: user
              - email_count = 0
              - user.emails.each_with_index do |email, index|
                = f.fields_for :emails, email, child_index: index do |email_fields|
                  = email_fields.email_field :email, placeholder: t("placeholders.standard_modal.email", count: index), required: index<1 ? true : false, data: {role: "email", check_url: droom.check_email_path, users_path: droom.users_path, user_id: user.id}
                  = email_fields.hidden_field :address_type_id
                  %span.warning.hidden.email_error
                    This email already exists! Please try with a different email address.
                    %br
                    %strong
                - email_count+=1
              - while email_count < 2
                = f.fields_for :emails, user.emails.new, child_index: email_count do |email_fields|
                  = email_fields.email_field :email, placeholder: t("placeholders.standard_modal.email", count: email_count), required: email_count<1 ? true : false, data: {role: "email", check_url: droom.check_email_path, users_path: droom.users_path, user_id: user.id}
                  = email_fields.hidden_field :address_type_id, value: email_count < 1 ? 1 : 4
                  %span.warning.hidden.email_error
                    This email already exists! Please try with a different email address.
                    %br
                    %strong
                - email_count += 1
              
              - if !@user.confirmed? && (admin? || @user.organisation && organisation_admin?(@user.organisation))
                %p.inputs.mt-8
                  %span.standard-checkbox
                    = f.check_box :send_confirmation
                    = f.label :send_confirmation, class: "standard-checkbox-label mb-10"

              %p
                - if me
                  = t :account_password
                - else
                  = t :admin_account_password
              
              .input-group
                = f.password_field :password, placeholder: t("placeholders.user.password"), minlength: 8, data: { validation_message: "Password must be at least 8 characters" }
                %button.eye-icon{type: "button"}
                  %img{alt: "open", src: "https://croucher.org.hk/assets/images/icons/eye-02.svg"}/

              - if admin?
                .account-permissions
                  - organisation_options = Droom::Organisation.for_selection.map { |name, id| [id.blank? ? 'No organisation assigned' : name, id] }
                  - if organisation_options.any? { |name, id| id.present? }
                    = f.label :organisation_id, 'Organisation', class: 'block mb-2'
                    = f.select :organisation_id, organisation_options, {}, :class => 'preferences mb-10'
                  .mb-10
                    %p.mb-2
                      %strong System administrator
                    %p#site-admin-guidance Broad administrative access to this site, including users and content. Not required for routine Library editing.
                    %span.standard-checkbox
                      = f.check_box :admin, aria: {describedby: 'site-admin-guidance'}
                      = f.label :admin, 'Allow system administration', class: 'standard-checkbox-label'
                  .subordinate.mb-10{data: {dependent: '#user_admin'}}
                    %p.mb-2
                      %strong Organisation registration notifications
                    %p#admissions-guidance Receives notifications when external organisations register. Applies only to system administrators.
                    %span.standard-checkbox
                      = f.check_box :gatekeeper, aria: {describedby: 'admissions-guidance'}
                      = f.label :gatekeeper, 'Receive registration notifications', class: 'standard-checkbox-label'
                  .mb-10
                    %p.mb-2
                      %strong Organisation administrator
                    %p#organisation-admin-guidance Allows management of the assigned organisation and its user accounts.
                    %span.standard-checkbox
                      = f.check_box :organisation_admin, aria: {describedby: 'organisation-admin-guidance'}
                      = f.label :organisation_admin, 'Allow organisation administration', class: 'standard-checkbox-label'

        .standard-modal-footer
          .buttons
            = link_to t(:cancel_edit), '#', :class => 'cancel submit-button'
            - if @user == current_user
              = f.submit t(:save_your_preferences), class: 'croucher-standard-btn inline'
            - else
              = f.submit t(:save_preferences), class: 'croucher-standard-btn inline'
