#passwordModal.modal{"data-turbo" => "false"}
  .modal-wrapper{role: "document"}
    .modal-content
      .standard-modal-overlay.active
        .standard-modal-container.active
          %svg.logo.ml-56
            %use{"xlink:href" => "#croucher_logo"}
          = form_for(resource, :as => resource_name, :url => password_path(resource_name), :html => {:class => 'edit user password', :autocomplete => false}) do |f|
            .container
              %h2 Reset your password
              .form-fields.inputs
                %section
                  %p
                    = t :forgot_password_title
                  %p.mb-3
                    = t :password_reset_instructions
                  = f.email_field :email,  :placeholder => t('placeholders.session.email'), :required => true, class: "required"
            %section.actions.buttons
              %button.croucher-standard-btn.modal-btn.cancel{type: "button"}
                Cancel
              %button.password-reset-btn.croucher-standard-btn.submit{type: 'button'}= t(:send_reset_instructions)

= render 'droom/users/passwords/email_confirm'
