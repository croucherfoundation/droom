- cssclass = 'account_info'
-# - cssclass << ' editable' if can?(:edit, @user)

%section{class: cssclass, data: {refreshing: true, url: droom.user_url(@user, view: 'account_info', format: :js)}}
  -# - if @user && can?(:edit, @user)
  -#   %span.user_controls
  -#     = link_to t(:edit_user_profile_symbol), droom.edit_user_url(@user, view: 'preferences'), class: "edit", data: {action: 'popup', affected: "section.account_info"}

  %h3.standard-h3-title.section
    = t :user_profile_account

  #account_info_container
    .right-pane-container
      .left-pane-contents
        = "Statuses: "
      %span.label.right-pane-contents
        = t ("status_labels.#{@user.liveliness}")
      -# %div{class: "liveliness #{@user.liveliness}"}
        -# %svg.icon.small
        -#   %use{href: "#user_#{@user.liveliness}_symbol"}
        
      
    .account_info_contents
      .right-pane-container
        .left_pane.left-pane-contents
          = 'Created at: '
        .right-pane-contents
          %b
            = @user.created_at.present? ? @user.created_at.strftime('%e %b %Y') : t(:not_known)
      .right-pane-container
        .mid_pane.left-pane-contents
          = 'Last signed in: '
        .right-pane-contents
          %b
            = @user.last_sign_in_at.present? ? @user.last_sign_in_at.strftime('%e %b %Y') : t(:not_known)

      .right-pane-container
        .right_pane.left-pane-contents
          = 'Data room access: '
        .right-pane-contents
          %b
            = @user.data_room_user? ? 'Yes' : 'No'

    .account_info_contents
      .right-pane-container
        .left_pane.left-pane-contents
          = 'Account confirmed?: '
        .right-pane-contents
          %b
            = @user.confirmed? ? 'Yes' : 'No'

      .right-pane-container
        .mid_pane.left-pane-contents
          = 'Confirmed at: '
        .right-pane-contents
          %b
            = @user.confirmed_at.present? ? @user.confirmed_at.strftime('%e %b %Y') : t(:not_known)

      .right-pane-container
        .right_pane.left-pane-contents
          = 'Administrator?: '
        .right-pane-contents
          %b
            = @user.admin? ? 'Yes' : 'No'
.section-divider
