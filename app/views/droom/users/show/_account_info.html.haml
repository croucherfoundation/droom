- cssclass = 'account_info'

%section{class: cssclass, data: {refreshing: true, url: droom.user_url(@user, view: 'account_info', format: :js)}}
  %h3.standard-h3-title.section
    = t :user_profile_account

  #account_info_container.text-body-secondary
    .detail-row
      .detail-label
        = "Statuses: "
      %span.label.detail-value
        = t ("status_labels.#{@user.liveliness}")
      
    .account_info_contents
      .detail-row
        .left_pane.detail-label
          = 'Created at: '
        .detail-value
          = @user.created_at.present? ? @user.created_at.strftime('%e %b %Y') : t(:not_known)
      .detail-row
        .mid_pane.detail-label
          = 'Last signed in: '
        .detail-value
          = @user.last_sign_in_at.present? ? @user.last_sign_in_at.strftime('%e %b %Y') : t(:not_known)

      .detail-row
        .right_pane.detail-label
          = 'Data room access: '
        .detail-value
          = @user.data_room_user? ? 'Yes' : 'No'

    .account_info_contents
      .detail-row
        .left_pane.detail-label
          = 'Account confirmed?: '
        .detail-value
          = @user.confirmed? ? 'Yes' : 'No'

      .detail-row
        .mid_pane.detail-label
          = 'Confirmed at: '
        .detail-value
          = @user.confirmed_at.present? ? @user.confirmed_at.strftime('%e %b %Y') : t(:not_known)

      .detail-row
        .right_pane.detail-label
          = 'Administrator?: '
        .detail-value
          = @user.admin? ? 'Yes' : 'No'
  .section-divider
