%section#signin-box.auth_container.auth_container_open
  .auth_container_wrapper
    .croucher_container
      .cross_icon_container
        %button{disabled: true}
          %svg{fill: "transparent",  height: "23", viewbox: "0 0 24 23", width: "24", xmlns: "http://www.w3.org/2000/svg"}
            %line{stroke: "#f8f8f5", "stroke-linecap" => "round", "stroke-width" => "2", transform: "matrix(0.719281 -0.694719 0.765788 0.643093 1.93701 22.1875)", x1: "1", x2: "29.4986", y1: "-1", y2: "-1"}
            %line{stroke: "#f8f8f5", "stroke-linecap" => "round", "stroke-width" => "2", transform: "matrix(0.719281 0.694719 -0.669051 0.743216 0 1.1875)", x1: "1", x2: "29.4986", y1: "-1", y2: "-1"}

    .croucher_container
      %h2.text-subtitle Unlock your account
      
      %br
      
      .instructions
        %p 
          = t :forgot_password_title
        %p 
          = t :password_reset_instructions
      = form_for(resource, :as => resource_name, :url => unlock_path(resource_name), :html => { :method => :post, class: 'sign_in_form' }) do |f|
        .input_group
          %label{for: "email"} Email
          = f.email_field :email, class: "#{'has-error' if params[:failed].present?}", placeholder: t("placeholders.session.email")       
        
        .buttons.sign_in_btn
          = f.submit t(:send), class: "croucher-standard-btn inline"
          = t :or
          = link_to t(:cancel), root_url, class: 'cancel'
