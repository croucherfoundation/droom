- permission ||= @permission

- if can?(:edit, permission)
  .menu{:data => {:for => "permission_#{permission.id}"}}
    %ul.actions
      %li
        = link_to droom.edit_service_permission_url(permission.service, permission), :class => 'edit', :data => {:action => "popup", :affected => "#services"} do
          %svg
            %use{href: "#edit_symbol"}
          = t(:edit_permission)
      %li
        = link_to droom.service_permission_url(permission.service, permission), :method => 'delete', :class => 'delete', :data => {:action => "remove_all", :removed => ".p_#{permission.id}", :affected => "#services", :confirm => t(:confirm_delete_permission, :name => permission.name, :service_name => permission.service.name)} do
          %svg
            %use{href: "#trash_symbol"}
          = t(:delete_permission)

