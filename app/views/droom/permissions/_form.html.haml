.standard-modal-overlay.active
  .standard-modal-container.active
    = form_for [@service, @permission], :html => { :multipart => true, :class => 'edit permission', :remote => true, :data => {:type => :html}} do |f|
      .standard-modal-header
        .standard-modal-close-btn.cursor-pointer
          %svg.standard_close_icon
            %use{"xlink:href" => "#standard_close_symbol"}
        %svg.logo
          %use{"xlink:href" => "#croucher_logo"}
        .container
          %h2
            = title

      .standard-modal-body
        .container
          .inputs
            %p.name
              = f.text_field :name, :class => 'name', :placeholder => t("placeholders.service.name"), :autofocus => true

            %p.description
              = f.text_area :description, :class => 'description medium', :placeholder => t("placeholders.service.description")

            %p.service
              = f.label :service_id
              %br
              = f.select :service_id, Droom::Service.for_selection

      .standard-modal-footer
        .buttons
          = link_to t(:cancel_edit), "/", :class => 'cancel submit-button'
          = f.submit t(:save_permission), class: 'croucher-standard-btn inline'
