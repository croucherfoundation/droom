- @seen_events ||= []
- event ||= @event
- here ||= event == @event
- skip_gdoc = true
- is_outside_event = event&.calendar_id == 2
- omit_document ||= false

- event_master_id = event.master_id || event.id
- if @seen_events[event_master_id]
  - repeating = true
  - brief = true
- @seen_events[event_master_id] = true;

- cssclasses = ['event']
- cssclasses << 'repeat' if repeating
- cssclasses << 'full' if here
- cssclasses << 'invited' if event.attended_by?(current_user)

- start_time = event_time_in_hk(event.start, event)
- finish_time = event_time_in_hk(event.finish, event)

- div_data = {refreshing: event_path(event, format: :js)}

%div{:class => cssclasses.join(' '), id: "event_#{event.id}", data: div_data}
  = link_to event_url(event) do
    - if is_outside_event
      %button.color_button{ style: "background-color: #{get_profile_color}; float: left;" }
    - else
      .datemark
        %span.mon= event.start.strftime('%b')
        %span.dom= event.start.strftime('%d')

  .summary
    .heading
      %h2.name<
        = link_to event.name, event_url(event), :class => "name"
      .detail-practicalities
        %p.practicalities
          %span.venue_time
            - if event.venue.url
              = link_to event.venue.definite_name, event.venue.url
            - elsif Droom.show_venue_map?
              = link_to event.venue.definite_name, venues_url(:id => event.venue.id)
            - else
              = event.venue.definite_name
            
            - if start_time
              %span.separator ·
              %time
                = start_time.strftime('%H:%M')
                - if finish_time
                  = " – #{finish_time.strftime('%H:%M')}"

            - if event.timezone == "London"
              %i.note{style: "display: block;"}
                = "#{event.start.strftime('%a · %H:%M')} (#{t(:uk_time)})"

        .detail
          - if event.description?
            .content{style: "width:100%"}
              = sanitize(event.description)
        - if event.url?
          .inline
            = t(:website) + ":"
            = link_to ensure_protocol(event.url), target: "_blank", style: "color:black" do
              %svg.icon{style: "height: 28px; padding-bottom: 1px"}
                %use{href: "#arrow_icon"}
        - if event.video_conference_link?
          .inline
            = t(:conference_call) + ":"
            = link_to ensure_protocol(event.video_conference_link), target: "_blank", style: "color:black" do
              %svg.icon{style: "height: 28px; padding-bottom: 1px"}
                %use{href: "#arrow_icon"}

    - unless omit_document  
      .single_document 
        - if event.compiled_file.attached?
          - doc_url = show_compiled_file_event_url(event)
        - elsif event.documents.count >= 1
          - doc_url = droom.folder_document_url(event.documents.first.folder, event.documents.first)
        
        = link_to doc_url, class: 'document pdf no-bg-image', target: "_blank", style: 'white-space: nowrap;' do
          %svg.icon.medium
            %use{"xlink:href" => "#pdf_symbol"}
