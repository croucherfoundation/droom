- content_for :pagetitle do
  = t(:calendar)

- content_for :title do
  = t(:calendar)
  
- content_for :buttons do
  %p.action.standard-btn-group.pt.pr
    - if can?(:create, Droom::Event)
      = link_to droom.new_event_url, class: "btn", data: {action: 'popup', affected: '#events'}  do
        = image_tag 'svg/add.svg', width: 20, height: 20 
        = t :add_event
      
      - if calendar = Droom::Calendar.where(name: 'stream').first
        = link_to droom.new_event_url(event: {calendar_id: calendar.id}), class: "btn", data: {action: "popup", affected: "#outside_events"} do
          = image_tag 'svg/add.svg', width: 20, height: 20 
          = t :add_external_event

    = link_to subscribe_events_url(current_user.authentication_token, protocol: "webcal", format: "ics"), class: "btn"  do
      %svg
        %use{href: "#calendar_symbol"}
      = t :subscribe_to_calendar

- content_for :subnavbar do
  = render :partial => 'subnavbar'

#calendar
  = render :partial => 'events'
