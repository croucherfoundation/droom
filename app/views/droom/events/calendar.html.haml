- content_for :pagetitle do 
  Calendar view 

- content_for :breadcrumb do
  .breadcrumb-container
    = link_to 'Home', root_path
    = link_to 'Events', croucher_droom_url("/calendar")
    = link_to 'Calendar', '#', class: 'disabled'

.calendar_container
  = render 'droom/events/calendar/toolbar'

  -# JS will populate this div with the calendar view
  #calendar_view.calendar_view{ data: { events: croucher_droom_url("/api/events/calendar?tok=#{current_user.authentication_token}") } }
    
  = render 'droom/events/calendar/dialog'

.calendar_spacer