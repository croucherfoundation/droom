- if can?(:edit, event) || can_add_document_to?(event.folder)
  .action-commands-dropdown.menu{data: {for: "event_#{event.id}"}, class: "event_#{event.id}_actions"}
    - if can?(:edit, event)
      = link_to droom.edit_event_url(event), class: 'edit btn', data: {action: "popup", replaced: "#event_#{event.id}", affected: ".minimonth"} do
        %svg
          %use{href: "#edit_symbol"}
        = t(:edit_event)
    - if can?(:edit, event)
      = link_to droom.compile_pdf_event_url(event), class: "add btn", target: '_blank' do
        = image_tag 'svg/add.svg', width: 18, height: 18
        = t(:compile_pdf)
    - if can_add_document_to?(event.folder)
      = link_to '#', class: "add btn", data: {role: "upload-file"} do
        = image_tag 'svg/add.svg', width: 18, height: 18
        = t(:add_document)
    - if can?(:edit, event)
      = link_to droom.edit_folder_url(event.folder), class: "add btn", data: {action: "popup", affected: "#event_#{event.id}"} do
        = image_tag 'svg/add.svg', width: 18, height: 18
        = t(:edit_event_folder)
    - if can?(:edit, event)
      = link_to droom.new_folder_folder_url(event.folder), class: "add btn", data: {action: "popup", affected: "#event_#{event.id}"} do
        = image_tag 'svg/add.svg', width: 18, height: 18
        = t(:add_subfolder)
    - if can?(:edit, event)
      = link_to droom.new_event_group_invitation_url(event), class: "add btn", data: {action: "popup", affected: "#event_#{event.id}"} do
        = image_tag 'svg/add.svg', width: 18, height: 18
        = t(:invite_group)
    - if can?(:edit, event)
      = link_to droom.event_url(event), method: 'delete', class: 'delete btn', data: {action: "remove", removed: "#event_#{event.id}", affected: ".minimonth", confirm: t(:confirm_delete_event, name: event.name)} do
        %svg
          %use{href: "#trash_symbol"}
        = t(:delete_event)
