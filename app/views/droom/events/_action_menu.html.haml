- if can? :edit, event
  .menu{data: {for: "event_#{event.id}"}}
    %ul.actions
      %li
        = link_to droom.edit_event_url(event), class: 'edit', data: {action: "popup", replaced: "#event_#{event.id}", affected: ".minimonth"} do
          %svg
            %use{href: "#edit_symbol"}
          = t(:edit_event)
      %li
        = link_to droom.compile_pdf_event_url(event), class: "add", target: '_blank' do
          %svg
            %use{href: "#add_symbol"}
          = t(:compile_pdf)
      %li
        = link_to '#', class: "add", data: {role: "upload-file"} do
          %svg
            %use{href: "#add_symbol"}
          = t(:add_document)
      %li
        = link_to droom.edit_folder_url(event.folder), class: "add", data: {action: "popup", affected: "#event_#{event.id}"} do
          %svg
            %use{href: "#edit_symbol"}
          = t(:edit_event_folder)
      %li
        = link_to droom.new_folder_folder_url(event.folder), class: "add", data: {action: "popup", affected: "#event_#{event.id}"} do
          %svg
            %use{href: "#add_symbol"}
          = t(:add_subfolder)
      %li
        = link_to droom.new_event_group_invitation_url(event), class: "add", data: {action: "popup", affected: "#event_#{event.id}"} do
          %svg
            %use{href: "#add_symbol"}
          = t(:invite_group)
      %li
        = link_to droom.event_url(event), method: 'delete', class: 'delete', data: {action: "remove", removed: "#event_#{event.id}", affected: ".minimonth", confirm: t(:confirm_delete_event, name: event.name)} do
          %svg
            %use{href: "#trash_symbol"}
          = t(:delete_event)
