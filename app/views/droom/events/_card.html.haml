- card ||= nil
- event = card || @event
.default_card
  .body_container
    .card_title
      = event.name 
    .card_desc
      .card_item 
        .icon 
          %svg.clock_icon
            %use{"xlink:href" => "#location_symbol"}
        .text 
          = event.venue.definite_name
      .card_item
        .icon 
          %svg.location_icon
            %use{"xlink:href" => "#clock_symbol"}
        .text 
          = event.start.strftime('%A %-d %B %Y, %H:%M')
          - if event.finish?
            – #{event.finish.strftime('%H:%M')}
      
      .card_item
        .card_text 
          = shorten(event.description, 100) if event.description?
