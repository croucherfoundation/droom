- content_for :pagetitle do
  = @event.name 
  
.pdf-container
  .outer-container
    .top-header
      %h3 
        = @event.name

    .content-wrapper
      .left-panel.hide-scrollbar
        %ul#thumbnail-list.sortable_files{data: {event_id: @event.id}}
          - @thumbnails.each_with_index do |image, index|
            %li.thumbnail-item.files{ data: { page_number: image.position, doc_id: image.id }, class: ('active' if index == 0)}
              .thumbnail-wrapper
                .delete-section
                  %button.delete-btn{ type: "button", data: { image_id: image.id, event_id: @event.id}, aria: { label: "Delete thumbnail" }, title: 'Delete PDF' }
                    .btn-text ×
                = image_tag image.image.url, class: "thumbnail", width: "100", loading: "lazy"
              %div.page-number{ data: { page_number: image.position } }
                = index + 1
        
        %ul#uploader
          %li.thumbnail-item.upload-slot
            .thumbnail-wrapper.upload-wrapper
              %input.upload-input{ type: "file", accept: "application/pdf", style: "display: none;" }
              %div.upload-label 
                %svg
                  %use{href: "#add_symbol"}

      .right-panel
        .preview-area
          %ul#preview-list
            - @single_documents.each do |pdf|
              %li.preview-item{ data: { page_number: pdf.position } }
                %iframe.pdf-frame{ src: "#{pdf.file.url}#toolbar=0&navpanes=0&scrollbar=0&view=fitH", scrolling: 'no', frameborder: 0, loading: 'lazy', width: "100%", height: "1105", allowtransparency: "true", style: "background: transparent;"  }
