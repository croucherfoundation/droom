= javascript_include_tag "pdfjs/pdf.js"
= javascript_include_tag "pdfjs/pdf.worker.js"

.pdf-container
  .outer-container
    .top-header
      %h3 Event PDF

    .content-wrapper
      .left-panel
        .upload-boxes
          - @images.each do |image, index|
            .upload-box{ data: { page_number: image[:page_number] } }
              = image_tag image.image.url, class: "thumbnail", width: "100px"
              %br
            %div.upload-number{ data: {page_number: image[:page_number] } }
              = "#{image[:page_number]}" 

      .right-panel
        .preview-area
          %div#preview-list
            - @pdfs.each do |pdf , index|
              .preview-image{ id: "page-#{pdf[:page_number]}", data: { page_number: pdf[:page_number] } }
                -# = image_tag pdf.pdf_single_page.url, class: "preview-img", style: "max-width: 60%"
                .preview-img
                  %iframe{ src: "#{pdf.pdf_single_page.url}#toolbar=0&navpanes=0&scrollbar=0&view=fitH", width: "70%", height: "1105", allowtransparency: "true", style: "border: none;  background-color: transparent; margin-left: 11rem;" }

:javascript
  document.addEventListener("DOMContentLoaded", function () {
    const rightPanel = document.querySelector(".right-panel");
    const leftPanel = document.querySelector(".left-panel");
    const uploadBoxes = document.querySelectorAll(".upload-box");
    const previewImages = document.querySelectorAll(".preview-image");
    const uploadNumbers = document.querySelectorAll(".upload-number");
    

    let visiblePageNumber = 1;
    let observer = new IntersectionObserver(
      (entries) => {
        let firstVisible = null;

        entries.forEach((entry) => {
          if (entry.isIntersecting && firstVisible === null) {
            firstVisible = entry.target.dataset.pageNumber;
          }
        });
        
        if (firstVisible) {
          visiblePageNumber = firstVisible;
          uploadBoxes.forEach((box) => {
            box.classList.toggle("active", box.dataset.pageNumber === visiblePageNumber);
          });

          uploadNumbers.forEach((num) => {
            num.classList.toggle("active", num.dataset.pageNumber === visiblePageNumber);
          });

          let activeBox = document.querySelector(`.upload-box[data-page-number="${visiblePageNumber}"]`);
          if (activeBox) {
            leftPanel.scrollTo({
              top: activeBox.offsetTop - leftPanel.offsetTop - 50, 
              behavior: "smooth",
            });
          }
        }
      },
      { root: rightPanel, threshold: 0.3 }
    );

    previewImages.forEach((image) => observer.observe(image));

    uploadBoxes.forEach((box) => {
      box.addEventListener("click", function () {
        let pageNumber = box.dataset.pageNumber;
        let target = document.getElementById(`page-${pageNumber}`);

        if (target) {
          rightPanel.scrollTo({
            top: target.offsetTop - rightPanel.offsetTop,
            behavior: "smooth",
          });
        }
      });
    });
  });
  