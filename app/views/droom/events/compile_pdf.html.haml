            = image_tag 'https://www.resumeviking.com/wp-content/uploads/2023/10/Classy-Casey-Cover-Letter-768x994.jpg', alt: '', height: '', width: '200px', class: ''
            %span.upload-number 4
            -# = file_field_tag :pdf_file, class: 'pdf-file-input'
              
      .right-panel
        .preview-area

:javascript
  document.addEventListener('DOMContentLoaded', function() {
    document.querySelector('.upload-boxes').addEventListener('change', function(event) {
      if (event.target.classList.contains('pdf-file-input')) {
        const newUploadBox = document.createElement('div');
        newUploadBox.classList.add('upload-box');
        newUploadBox.innerHTML = '<input type="file" name="pdf_file" class="pdf-file-input">';

        document.querySelector('.upload-boxes').appendChild(newUploadBox);
      }
    });
  });




