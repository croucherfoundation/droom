- @event.calendar ||= Droom::Calendar.default_calendar
- calendar_id = params.dig(:event, :calendar_id) || @event.calendar_id
- is_outside_event = calendar_id.to_i == 2
- modal_title = is_new ? t(:add_event) : t(:edit_event)

