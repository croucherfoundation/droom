#compile_pdf
  = render 'droom/shared/popup_header', title: t(:compile_pdf)

  = form_with url: compile_pdf_selection_event_url(@event), method: :post, class: 'compile-pdf' do
    .type
      = label_tag :compile_type, "Compile type"
      %br
      = select_tag :compile_type, options_for_select([['Compile all attachments', 'all'], ['Compile selected attachments', 'selected'] ])
    
    .buttons
      = link_to t(:compile), '#', class: 'croucher-standard-btn inline', id: 'compile-pdf-btn'
      = t :or
      = link_to t(:cancel), "/", :class => 'cancel'

