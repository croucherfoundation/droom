#compile_pdf
  .standard-modal-overlay.active
    .standard-modal-container.active
      = form_for @event, url: compile_pdf_selection_event_url(@event), method: :post, html: { class: 'compile-pdf' } do |f|
        .standard-modal-header
          .standard-modal-close-btn.cursor-pointer
            %svg.standard_close_icon
              %use{"xlink:href" => "#standard_close_symbol"}
          %svg.logo
            %use{"xlink:href" => "#croucher_logo"}
          .container
            %h2
              Compile meeting PDF

        .standard-modal-body
          .container
            .inputs 
              %p.type
                = f.select :compile_type, [['Compile all attachments', 'all'], ['Compile selected attachments', 'selected']], {prompt: 'Select'}, { id: 'compile-type' }
              
              %br
              
              %p.compile-documents
                = f.select :selected_document_ids, @event.documents.for_selection, {}, { multiple: true, id: 'selected-document-ids', style: 'display: none' }
          
          %br

        .standard-modal-footer
          .buttons
            = link_to t(:cancel_edit), "/", class: 'cancel submit-button'
            = button_tag t(:save), type: 'button', class: 'submit croucher-standard-btn inline', id: 'compile-pdf-btn'

:javascript
  $(document).ready(function() {
    $('#selected-document-ids').selectize();

    var compileType = "#{@event.compile_type}";

    if (compileType === 'selected') {
      $('.compile-documents .selectize-control').show();
    } else {
      $('.compile-documents .selectize-control').hide();
    }

    $('#compile-type').on('change', function() {
      if ($(this).val() === 'selected') {
        $('.compile-documents .selectize-control').show();
      } else {
        $('.compile-documents .selectize-control').hide();
      }
    });
  });
