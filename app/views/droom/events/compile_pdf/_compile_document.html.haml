%li.files  
  %ul
    %li.document{id: "compiled_file_#{event.id}"}
      = link_to show_compiled_file_event_url(event), class: 'document pdf no-bg-image', target: "_blank", style: 'white-space: nowrap;' do
        %svg.icon.medium
          %use{"xlink:href" => "#pdf_symbol"}
        %span
          = event.generate_compiled_pdf_filename

      = link_to 'Edit', '#', class: 'menu', data: { menu: "compiled_file_#{event.id}" }

      = render partial: 'droom/events/compile_pdf/action_menu', locals: { event: event }
