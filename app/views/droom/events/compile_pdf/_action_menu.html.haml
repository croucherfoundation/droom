- event ||= @event
- compiled_file ||= event.compiled_file

- if can? :edit, event
  .action-commands-dropdown.menu{:data =>{:for => "compiled_file_#{event.id}"}, class: "compiled_file_#{event.id}_actions"}
    = link_to droom.compile_pdf_event_url(event), class: "edit btn", target: '_blank' do
      %svg
        %use{href: "#edit_symbol"}
      = t(:edit_document)
    = link_to droom.delete_pdf_event_url(event), :method => 'delete', :class => 'delete btn', :data => {:action => "remove", :removed => "#compiled_file_#{event.id}", :affected => ".minimonth", :confirm => t(:confirm_delete_document, :name => event.generate_compiled_pdf_filename)} do
      %svg
        %use{href: "#trash_symbol"}
      = t(:delete_document)
