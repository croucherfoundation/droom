- event ||= @event
- compiled_file ||= event.compiled_file

- if can? :edit, event
  .menu{:data =>{:for => "compiled_file_#{event.id}"}}
    %ul.actions
      %li
        = link_to t(:edit_document), droom.compile_pdf_event_url(event), class: "edit", target: '_blank'
      %li
        = link_to t(:delete_document), droom.delete_pdf_event_url(event), :method => 'delete', :class => 'delete', :data => {:action => "remove", :removed => "#compiled_file_#{event.id}", :affected => ".minimonth", :confirm => t(:confirm_delete_document, :name => event.generate_compiled_pdf_filename)}
