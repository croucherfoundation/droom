- content_for :pagetitle do
  Compile meeting PDF
  
.pdf-container
  .outer-container
    .top-header
      %h3 
        = @event.meeting_number
        = @event.name
      .action-buttons
        .compile-attchements{title: "Compile PDF"}
          = link_to droom.compile_pdf_selection_event_url(@event), class: "add btn", data: {action: "popup", affected: "#event_#{@event.id}"} do
            %svg
              %use{href: "#gear_symbol"}
            = t(:compile_attachements)
        .save-combine-pdf{title: "Save PDF"}
          %span.btn
            %svg
              %use{href: "#save_symbol"}
            = t(:save_document)
        .download-combine-pdf{title: "Download PDF"}
          %span.btn
            %svg
              %use{href: "#download_symbol"}
            = t(:download_compile_pdf)

    .content-wrapper
      .left-panel.hide-scrollbar
        %ul#thumbnail-list.sortable_files{data: {event_id: @event.id}}
          - @thumbnails.each_with_index do |image, index|
            %li.thumbnail-item.files{ data: { page_number: image.position, doc_id: image.id }, class: ('active' if index == 0)}
              .thumbnail-wrapper
                - unless index == 0
                  .delete-section 
                    %button.delete-btn{ type: "button", data: { image_id: image.id, event_id: @event.id}, aria: { label: "Delete thumbnail" }, title: 'Delete PDF' }
                      .btn-text ×
                = image_tag image.image.url, class: "thumbnail", width: "100", loading: "lazy"
              %div.page-number{ data: { page_number: image.position } }
                = index + 1
        
        %ul#uploader
          %li.thumbnail-item.upload-slot
            .thumbnail-wrapper.upload-wrapper
              %input.upload-input{ type: "file", accept: "application/pdf", style: "display: none;" }
              %div.upload-label 
                %svg
                  %use{href: "#add_symbol"}


      .right-panel
        .preview-area
          %ul#preview-list
            - @single_documents.each do |pdf|
              %li.preview-item{ data: { page_number: pdf.position, pdf_url: serve_pdf_single_document_path(pdf) } }
                %canvas.pdf-canvas{ id: "canvas-#{pdf.id}", width: "100%" }

