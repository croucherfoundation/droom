- past ||= false
- restricted_slugs = []
- restricted_slugs << 'screening' if current_user.screener?
- restricted_slugs << 'award_interview' if current_user.interviewer?
- event_types = restricted_slugs.any? ? Droom::EventType.where(slug: restricted_slugs) : Droom::EventType.all

%fieldset.search_options.mb.faceting{data: {refreshing: true}}
  .croucher_dropdown_container
    .parent_custom_dropdown
      - event_type_options = event_types.map{|et| [et.name, et.id]}
      = select_tag "event_type", options_for_select(event_type_options, params[:event_type]), { include_blank: t(:event_type_admin), class: "facet custom_dropdown custom-img" }

    - if past 
      .parent_custom_dropdown
        - start_year = 1978
        - max_year = Droom::Event.pluck(:start).compact.map(&:year).uniq.max
        - years = (start_year..max_year).to_a.reverse

        = select_tag "year", options_for_select(years, params[:year]), { include_blank: t(:filter_year), class: "facet custom_year_width custom_dropdown custom-img" }