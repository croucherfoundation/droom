- past ||= false 

%fieldset.search_options.mb.faceting{data: {refreshing: true}}
  .croucher_dropdown_container
    .parent_custom_dropdown
      - event_type_options = Droom::EventType.all.map{|et| [et.name, et.id]}
      = select_tag "event_type", options_for_select(event_type_options, params[:event_type]), { include_blank: t(:all_types), class: "facet custom_dropdown custom-img" }

    - if past 
      .parent_custom_dropdown
        - start_year = 1978
        - max_year = Droom::Event.pluck(:start).compact.map(&:year).uniq.max
        - years = (start_year..max_year).to_a.reverse

        = select_tag "year", options_for_select(years, params[:year]), { include_blank: t(:filter_year), class: "facet custom_year_width custom_dropdown custom-img" }