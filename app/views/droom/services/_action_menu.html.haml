- service ||= @service

- if can?(:edit, service)
  .action-commands-dropdown.services.menu{:data => {:for => "service_#{service.id}"}, class: "service_#{service.id}_actions"}
    = link_to droom.edit_service_url(service), :class => 'edit btn', :data => {:action => "popup", :affected => "#services"} do
      %svg
        %use{href: "#edit_symbol"}
      = t(:edit_service)
    = link_to droom.service_url(service), :method => 'delete', :class => 'delete btn', :data => {:action => "remove_all", :removed => ".s_#{service.id}", :confirm => t(:confirm_delete_service, :name => service.name)} do
      %svg
        %use{href: "#trash_symbol"}
      = t(:delete_service)
    = link_to droom.new_service_permission_url(service), :class => 'add btn', :data => {:action => "popup", :affected => "#services"} do
      = image_tag 'svg/add.svg', width: 18, height: 18
      = t(:add_permission)
