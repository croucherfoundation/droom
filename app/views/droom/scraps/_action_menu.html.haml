- if can? :edit, scrap
  .action-commands-dropdown.menu{:data => {:for => "scrap_#{scrap.id}"}, class: "scrap_#{scrap.id}_actions"}
    = link_to droom.edit_scrap_url(scrap), :class => 'edit btn', :data => {:action => "popup", :affected => "#scraps"} do
      %svg
        %use{href: "#edit_symbol"}
      = t(:edit_scrap)
    = link_to droom.scrap_url(scrap), :method => 'delete', :class => 'delete btn', :data => {:action => "remove", :removed => "#scrap_#{scrap.id}", :affected => "#scraps", :confirm => t(:confirm_delete_scrap, :type => scrap.scraptype)} do
      %svg
        %use{href: "#trash_symbol"}
      = t(:delete_scrap)
    /= link_to droom.new_folder_document_url(scrap.folder), :class => "add btn", :remote => true, :data => {:action => "popup", :type => "html", :affected => "#scrap_#{scrap.id}"} do
    /  %svg
    /    %use{href: "#add_symbol"}
    /  = t(:add_document)