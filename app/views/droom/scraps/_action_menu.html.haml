- if can? :edit, scrap
  .menu{:data => {:for => "scrap_#{scrap.id}"}}
    %ul.actions
      %li
        = link_to droom.edit_scrap_url(scrap), :class => 'edit', :data => {:action => "popup", :affected => "#scraps"} do
          %svg
            %use{href: "#edit_symbol"}
          = t(:edit_scrap)
      %li
        = link_to droom.scrap_url(scrap), :method => 'delete', :class => 'delete', :data => {:action => "remove", :removed => "#scrap_#{scrap.id}", :affected => "#scraps", :confirm => t(:confirm_delete_scrap, :type => scrap.scraptype)} do
          %svg
            %use{href: "#trash_symbol"}
          = t(:delete_scrap)
      %li
        / = link_to t(:add_document), droom.new_folder_document_url(scrap.folder), :class => "add", :remote => true, :data => {:action => "popup", :type => "html", :affected => "#scrap_#{scrap.id}"}