.content
  .notice_body
    %blockquote
      = strip_tags(notice.body)

    .compact
      %figcaption
        = sanitize(notice.note).truncate(300, :separator => " ").html_safe
    .expanded
      %figcaption
        = sanitize(notice.note)
  
  - if notice.tags.any?
    %p.practicalities
      = render "droom/tags/summary", tags: notice.tags

