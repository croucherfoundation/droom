- sortable ||= @sortable.presence || false
- skip_gdoc ||= false
- listing ||= nil
- omit_menu ||= false
- document ||= listing || @document
- narrow ||= false
- character_count = narrow ? 28 : 64

%li.document{:id => "document_#{document.id}", data: {narrow: narrow, doc_id: document.id, scan_status: document.respond_to?(:scan_status) ? document.scan_status : 'clean'}}
  - if (link_info = document_external_link_info(document))
    - detail_url = link_info[:url]
    - extension = link_info[:extension]
  - else
    - extension = document.file_extension.downcase
    - detail_url = droom.folder_document_url(document.folder, document)

  - cssclasses = "document #{extension} no-bg-image"

  - unless skip_gdoc && document_has_external_link?(document)
    - if sortable
      %span.drag-handle{title: "Drag to reorder"}
        %svg.icon
          %use{"xlink:href": "#grid_symbol"}

    = link_to detail_url, class: cssclasses, target: "_blank" do
      - if %w[doc docx pdf txt gdoc notion memo].include?(extension)
        %svg.icon.standard{style: "margin-top: -4px;"}
          %use{"xlink:href" => "#pdf_symbol"}
      - elsif %w[jpg jpeg png psd tiff tif webp].include?(extension)
        %svg.icon.standard{style: "margin-top: -4px;"}
          %use{"xlink:href" => "#image_symbol"}
      - elsif %w[xls xlsx csv].include?(extension)
        %svg.icon.standard{style: "margin-top: -4px;"}
          %use{"xlink:href" => "#spreadsheet_symbol"}
      - elsif %w[zip rar gz tar 7z].include?(extension)
        %svg.icon.standard{style: "margin-top: -3px;"}
          %use{"xlink:href" => "#folder_closed_symbol"}
      - else
        %svg.icon.standard{style: "margin-top: -4px;"}
          %use{"xlink:href" => "#document_noline_symbol"}
      %span
        = shorten(document.name, 100, '')
    - unless omit_menu
      .standard-btn-group.inline.action-menu-pos.t-8
        .more-actions
          = action_menulink(document, class: 'toggle-commands-dropdown')
          = action_menu(document)

  - if document.respond_to?(:scan_status) && document.scan_status == "pending"
    %span.scan-status.scanning{title: "File is being scanned for viruses"}
      ⏳ Scanning...
  - elsif document.respond_to?(:scan_status) && document.scan_status == "infected"
    %span.scan-status.infected{title: "This file was found to contain malware and has been removed"}
      🚨 Malware detected
  - elsif document.respond_to?(:scan_status) && document.scan_status == "scan_error"
    %span.scan-status.scan-error{title: "Virus scan could not be completed"}
      ⚠️ Scan error