- sortable ||= @sortable.presence || false
- skip_gdoc ||= false
- listing ||= nil
- omit_menu ||= false
- document ||= listing || @document
- narrow ||= false
- character_count = narrow ? 28 : 64

%li.document{:id => "document_#{document.id}", data: {narrow: narrow, doc_id: document.id}}
  - if (link_info = document_external_link_info(document))
    - detail_url = link_info[:url]
    - extension = link_info[:extension]
  - else
    - extension = document.file_extension.downcase
    - detail_url = droom.folder_document_url(document.folder, document)

  - cssclasses = "document #{extension}"
  - cssclasses << ' no-bg-image' if %w[pdf gdoc notion memo png jpg jpeg webp].include?(extension)

  - unless skip_gdoc && document_has_external_link?(document)
    - if sortable
      %span.drag-handle{title: "Drag to reorder"}
        %svg.icon
          %use{"xlink:href": "#grid_symbol"}

    = link_to detail_url, class: cssclasses, target: "_blank" do
      - if %w[pdf png jpg jpeg webp memo].include?(extension)
        %svg.icon.standard
          %use{"xlink:href" => "#pdf_symbol"}
      - elsif %w[gdoc notion].include?(extension)
        %svg.icon.standard
          %use{"xlink:href" => "##{link_info[:symbol]}"}
      %span
        = shorten(document.name, 100, '')
    - unless omit_menu
      .standard-btn-group.inline.action-menu-pos.t-8
        .more-actions
          = action_menulink(document, class: 'toggle-commands-dropdown')
          = action_menu(document)
