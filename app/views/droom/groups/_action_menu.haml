- if can? :edit, group
  .action-commands-dropdown.menu{:data => {:for => "group_#{group.id}"}, class: "group_#{group.id}_actions"}
    = link_to droom.edit_group_url(group), :class => 'edit btn', :data => {:action => "popup", :replaced => "#group_#{group.id}"} do
      %svg
        %use{href: "#edit_symbol"}
      = t(:edit_group)
    /= link_to droom.new_group_membership_url(group), :class => 'add btn', :data => {:action => "popup", :affected => "#group_#{group.id}"} do
    /  %svg
    /    %use{href: "#add_symbol"}
    /  = t(:add_member)
    = link_to droom.group_url(group), :method => 'delete', :class => 'delete btn', :data => {:action => "remove", :removed => "#group_#{group.id}", :confirm => t(:confirm_delete_group, :name => group.name)} do
      %svg
        %use{href: "#trash_symbol"}
      = t(:delete_group)
