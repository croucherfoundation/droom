- group ||= @group
- users = @users || group.users.page(1).per(20)

%div.group.first-c-no-pt{:id => "group_#{group.id}", :data => {:refreshing => true, :url => group_path(group, :format => :js)} }
  %h3.standard-h3-title
    = group.name
    .standard-btn-group.inline.action-menu-pos
      .more-actions
        = action_menulink(group, class: 'toggle-commands-dropdown')
        = action_menu(group)

  - if users.count > 0
    .scroller.full-w
      = render partial: "droom/groups/users", locals: {group: group, users: users}
  - else
    %p
      = t(:no_users_in_group)