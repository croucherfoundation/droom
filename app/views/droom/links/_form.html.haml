.standard-modal-overlay.active
  .standard-modal-container.active
    %svg.pl-96
      %use{"xlink:href" => "#croucher_logo"}
    = form_for @link, :html => {:class => 'edit link'} do |f|
      .container
        %h2
          = t title
        .inputs
          %p.error{style: 'color: red'}
          %p.name
            = f.label :name
            %br
            = f.text_field :name, required: true, class: "name", placeholder: t("helpers.label.link.name"), autofocus: true, data: {role: 'name'}
          %p.url
            = f.label :url
            %br
            = f.text_field :url, required: true, class: "url", placeholder: t("helpers.label.link.url"), data: {role: 'url'}

      .buttons
        = link_to t(:cancel_edit), '#', :class => 'cancel submit-button'
        = f.submit t(:save_link), class: 'croucher-standard-btn inline'
