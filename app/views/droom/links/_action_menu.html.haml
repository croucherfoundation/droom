- if can? :edit, link
  .action-commands-dropdown.menu{:data =>{:for => "link_#{link.id}"}, class: "link_#{link.id}_actions"}
    = link_to droom.edit_link_url(link), :class => "edit btn", :data => {:action => "popup", :type => "html", :affected => "#link_#{link.id}"} do
      %svg
        %use{href: "#edit_symbol"}
      = t(:edit_link)
    = link_to droom.link_url(link), :method => 'delete', :class => 'delete btn', :data => {:action => "remove", :removed => "#link_#{link.id}", :confirm => t(:confirm_delete_link)} do
      %svg
        %use{href: "#trash_symbol"}
      = t(:delete_link)
