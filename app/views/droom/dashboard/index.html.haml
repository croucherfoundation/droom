- if external_user?
  = render :partial => "droom/dashboard/external"

- else
  -content_for :standfirst do
    = render :partial => "droom/dashboard/welcome"

  - if current_user.admin? || current_user.permitted?('droom.calendar') || current_user.permitted?('droom.calendar.read')
    - screeners = current_user.screeners
    .dashboard
      - Droom.main_dashboard_modules.each do |mod|
        = render :partial => "droom/dashboard/#{mod}"
    .outside_events
      - Droom.margin_dashboard_modules.each do |mod|
        = render :partial => "droom/dashboard/#{mod}"
    - if screeners.any?
      - open_screeners = screeners.select { |screener| screener.round.open? }.sort_by { |screener| screener.round.screening_end }
      - closed_screeners = screeners.select { |screener| !screener.round.open? }.sort_by { |screener| screener.round.screening_end }.reverse
      - sorted_screeners = open_screeners + closed_screeners
      .screeners.redline_section_divider
        %h3.text-subtitle.mb_subtitle Screening
        = render partial: "droom/dashboard/screeners", collection: sorted_screeners, as: :screener
