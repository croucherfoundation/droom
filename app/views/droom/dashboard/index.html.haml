- if external_user?
  = render :partial => "droom/dashboard/external"

- else
  - content_for :standfirst do
    = render :partial => "droom/dashboard/welcome"

  - if current_user.admin? || current_user.permitted?('droom.calendar') || current_user.permitted?('droom.calendar.read')
    - screeners = current_user.screeners
    .dashboard
      - Droom.main_dashboard_modules.each do |mod|
        = render :partial => "droom/dashboard/#{mod}"
    .outside_events.event_list
      - Droom.margin_dashboard_modules.each do |mod|
        = render :partial => "droom/dashboard/#{mod}", :locals => {:centered => true}
    - if screeners.any?
      - open_screeners = screeners.select { |screener| screener.round&.open? }.sort_by { |screener| screener.round&.screening_end || Time.current }
      - closed_screeners = screeners.select { |screener| !screener.round&.open? }.sort_by { |screener| screener.round&.screening_end || Time.zone.at(0) }.reverse
      - sorted_screeners = open_screeners + closed_screeners
      .screeners
        %h3.standard-h3-title
          = t(:selection_rounds)
        = render partial: "droom/dashboard/screeners", collection: sorted_screeners, as: :screener

  - else
    = render :partial => "droom/dashboard/my_events"

    - screeners = current_user.screeners
    - if screeners.any?
      - open_screeners = screeners.select { |screener| screener.round&.open? }.sort_by { |screener| screener.round&.screening_end || Time.current }
      - closed_screeners = screeners.select { |screener| !screener.round&.open? }.sort_by { |screener| screener.round&.screening_end || Time.zone.at(0) }.reverse
      - sorted_screeners = open_screeners + closed_screeners
      .screeners
        %h3.standard-h3-title
          = t(:selection_rounds)
        = render partial: "droom/dashboard/screeners", collection: sorted_screeners, as: :screener
