- centered ||= false
#suggestion_box

- if calendar = Droom::Calendar.where(name: 'stream').first
  
  #minimal{:data => {:refreshing => true}}
    - tag = centered ? 'h3' : 'h2'
    = content_tag tag, class: (centered ? 'text-smallsubtitle mb_subtitle no_redtag' : 'section') do
      = t(:external_events)
    = render "droom/calendars/event_list", calendar: calendar, events: calendar.events.current_and_onwards.limit(10)

