- event ||= @event

- start_day = event.start
- end_day = event.end_date

- if start_day.present? && end_day.present?
  - if start_day.to_date == end_day.to_date
    = start_day.strftime('%A %-d %B %Y')
  - elsif start_day.year != end_day.year
    = start_day.strftime('%A %-d %B %Y')
    –
    = end_day.strftime('%A %-d %B %Y')
  - elsif start_day.month != end_day.month
    = start_day.strftime('%A %-d %B')
    –
    = end_day.strftime('%A %-d %B %Y')
  - elsif start_day.month == end_day.month
    = start_day.strftime('%-d')
    –
    = end_day.strftime('%-d %B %Y')
  - elsif start_day.day != end_day.day
    = start_day.strftime('%A %-d')
    –
    = end_day.strftime('%A %-d %B %Y')
- elsif start_day.present?
  = start_day.strftime('%A %-d %B %Y')
