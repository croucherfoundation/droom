- content_for :pagetitle do
  = t :event_type_admin

- content_for :title do
  = t :event_type_admin

- content_for :subnavbar do
  = render :partial => 'shared/grants_subnavbar'

- content_for :standfirst do
  = t :event_types_introduction

- content_for :buttons do
  %p.action.standard-btn-group.pt.pr
    - if can?(:create, Droom::EventType)
      = link_to droom.new_event_type_url, class: "btn", data: {action: 'popup', affected: '.event_types'}  do
        = image_tag 'svg/add.svg', width: 16, height: 16 
        = t :add_event_type

#event_types
  = render :partial => 'event_types'
