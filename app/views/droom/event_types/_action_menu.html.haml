- if can? :edit, event_type
  .menu{:data => {:for => "event_type_#{event_type.id}"}}
    %ul.actions
      %li
        = link_to droom.new_event_url(event: {event_type_id: event_type.id}), :class => 'add', :data => {:action => "popup", :affected => "#event_type_#{event_type.id}"} do
          %svg
            %use{href: "#add_symbol"}
          = t(:add_event)
      %li
        = link_to droom.edit_event_type_url(event_type), :class => 'edit', :data => {:action => "popup", :replaced => "#event_type_#{event_type.id}"} do
          %svg
            %use{href: "#edit_symbol"}
          = t(:edit_event_type)
      %li
        = link_to droom.event_type_url(event_type), :method => 'delete', :class => 'delete', :data => {:action => "remove", :removed => "#event_type_#{event_type.id}", :confirm => t(:confirm_delete_event_type, :name => event_type.name)} do
          %svg
            %use{href: "#trash_symbol"}
          = t(:delete_event_type)
