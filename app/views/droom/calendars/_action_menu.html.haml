- cal ||= calendar
- if can? :edit, cal
  .action-commands-dropdown.menu{:data => {:for => "calendar_#{calendar.id}"}, class: "calendar_#{calendar.id}_actions"}
    = link_to droom.edit_calendar_url(cal), :class => 'edit btn', :data => {:action => "popup", :replaced => "#calendar_#{calendar.id}", :affected => "#calendars"} do
      %svg
        %use{href: "#edit_symbol"}
      = t(:edit_calendar)
    = link_to droom.calendar_url(cal), :method => 'delete', :class => 'delete btn', :data => {:action => "remove", :removed => "#calendar_#{calendar.id}", :affected => "#calendars", :confirm => t(:confirm_delete_calendar, :name => calendar.name)} do
      %svg
        %use{href: "#trash_symbol"}
      = t(:delete_calendar)
