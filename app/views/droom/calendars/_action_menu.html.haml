- cal ||= calendar
- if can? :edit, cal
  .menu{:data => {:for => "calendar_#{calendar.id}"}}
    %ul.actions
      %li
        = link_to droom.edit_calendar_url(cal), :class => 'edit', :data => {:action => "popup", :replaced => "#calendar_#{calendar.id}", :affected => "#calendars"} do
          %svg
            %use{href: "#edit_symbol"}
          = t(:edit_calendar)
      %li
        = link_to droom.calendar_url(cal), :method => 'delete', :class => 'delete', :data => {:action => "remove", :removed => "#calendar_#{calendar.id}", :affected => "#calendars", :confirm => t(:confirm_delete_calendar, :name => calendar.name)} do
          %svg
            %use{href: "#trash_symbol"}
          = t(:delete_calendar)
