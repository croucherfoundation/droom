
- folder_ul_class = @sortable ? "sortable_folders" : ""
- files_ul_class = @sortable ? "sortable_files" : ""

.folders{data: {library_results: true, panel: false, refreshing: droom.folder_path(@folder, source: 'library', format: :js, view: @library_view, sortable: @sortable), droppable: (droom.folder_documents_path(@folder) if can_add_document_to?(@folder)), picker: "#upload_to_folder_#{@folder.id}", queue: "#upload_queue"}, id: "folder_#{@folder.id}"}

  - unless @sortable
    %form#folder_search{action: request.path, method: :get, data: {library_search: true}}
      = hidden_field_tag :skip_gdoc, true if @skip_gdoc
      = hidden_field_tag :sort, params[:sort] if params[:sort].present?
      = hidden_field_tag :show, params[:show]
      = hidden_field_tag :view, @library_view
      = hidden_field_tag :user_id, params[:user_id], class: 'facet'


      = render 'droom/folders/library_filters'
      %noscript
        %button{type: 'submit'} Apply filters

  - if @searching
    = render partial: 'droom/folders/search_results'
  - else
    - if @folder.children.any? || @folder.documents.any?
      %ul#folders{class: folder_ul_class}
        - @folder.children.each do |child|
          = render partial: 'droom/folders/folder', locals: {folder: child, sortable: @sortable || false}
        %li.files
          %ul#upload_queue{class: files_ul_class, data: {folder_id: @folder.uid}}
            - @folder.documents.each do |doc|
              = render partial: 'droom/documents/listing', locals: {listing: doc, skip_gdoc: @skip_gdoc || false, sortable: @sortable || false}
    - else
      %ul#upload_queue{data: {folder_id: @folder.id}}
      .nomatch
        %h2
          Sorry: no documents
