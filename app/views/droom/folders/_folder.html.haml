- folder ||= @folder
- sortable ||= @sortable.presence || false
- skip_gdoc ||= @skip_gdoc.presence || false
- @skip_gdoc_menu = skip_gdoc

- if can? :read, folder
  - standalone ||= false
  - title ||= folder.name || folder.slug
  - open ||= false
  - limit ||= false
  - for_more ||= false
  - omit_menu ||= false
  - flat ||= false
  - stem ||= ""
  - narrow ||= false
  - length = narrow ? 28 : 64
  - opts = {skip_gdoc: skip_gdoc, shareable: true, sortable: sortable}
  - url = droom.folder_path(folder, opts)

  - if @folder
    - open = true if folder == @folder || folder.ancestor_of?(@folder)

  - defer_contents ||= !open
  - cssclass = "folder text-body"
  - cssclass << " open" if open && !folder.loose?
  - cssclass << " root" if folder.loose?
  - cssclass << " empty" unless folder.populated?
  - cssclass << " standalone" if standalone
  - cssclass << " auto" if folder.automatic? && can?(:edit, folder)

  %li{class: cssclass, id: "folder_#{folder.uid}", data: {label: folder.slug, folder_behavior: "navigate"}}<
    - if sortable
      %span.drag-handle{title: "Drag to reorder"}
        %svg.icon
          %use{"xlink:href": "#grid_symbol"}
    = link_to droom.folder_path(folder), class: "folder no-bg-image" do
      %svg.icon.standard{style: "margin-top: -3px;"}
        %use{"xlink:href" => "#folder_closed_symbol"}
      %span= shorten(title, length)
    %span.date-meta
      = folder.last_modified_at.strftime("%-d %b %Y")

