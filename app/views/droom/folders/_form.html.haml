.standard-modal-overlay.active
  .standard-modal-container.active
    = form_for @folder, :html => {:class => 'edit folder'} do |f|
      .standard-modal-header
        .standard-modal-close-btn.cursor-pointer
          %svg.standard_close_icon
            %use{"xlink:href" => "#standard_close_symbol"}
        %svg.logo
          %use{"xlink:href" => "#croucher_logo"}

      .standard-modal-body
        .container
          %h2
            = t title
          .inputs
            = f.hidden_field :parent_id

            %p.error{style: 'color: red'}
            %p.name
              = f.label :name
              %br
              = f.text_field :name, required: true, class: "name", placeholder: t("helpers.label.folder.name"), autofocus: true, data: {role: 'name'}

            %p.slug
              %strong<
              - if @folder.parent
                = @folder.parent.path + "/"
              - else
                \/
              %br
              = f.text_field :slug, :class => "slug", :placeholder => t("helpers.label.folder.slug"), data: {role: 'slug'}, readonly: true, style: "background: #eee"

      .standard-modal-footer
        .buttons
          = link_to t(:cancel_edit), '#', :class => 'cancel submit-button'
          = f.submit t(:save_folder), class: 'croucher-standard-btn inline'
