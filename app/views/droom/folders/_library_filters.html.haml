- selected = {}
- if params[:user_id].present?
  - selected[:user_id] = "#{@filter_user&.formal_name || 'Selected person'} (#{@search_results.total_count})"
= render layout: 'shared/cds_filters', locals: {fields: @library_filter_fields, extra_active: selected, query_defaults: {view: @library_view}} do
  - if can?(:search, Droom::User)
    %span.user-filter-target
  - if local_assigns[:show_view_picker]
    = render 'droom/folders/view_navigation'
