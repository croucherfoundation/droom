#library-search
  - if @search_results.any?
    - @search_results.each do |result|
      - if result.is_a?(Droom::Folder)
        = render partial: 'droom/folders/search/folder_result', locals: {folder: result}
      - elsif result.is_a?(Droom::Document)
        = render partial: 'droom/folders/search/document_result', locals: {document: result}

    .pagination.lower
      = paginate @search_results, params: {format: nil}

  - else
    .nomatch
      %h2
        = t :sorry_no_matches
    