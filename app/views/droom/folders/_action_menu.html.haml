- if can? :edit, folder
  .action-commands-dropdown.menu{:data =>{:for => "folder_#{folder.id}"}, class: "folder_#{folder.id}_actions"}
    = link_to 'javascript:void(0)', :class => "copy add btn", :id => "copy_folder_#{folder.id}", data: {:action => 'copy', :clipboard_text => droom.folder_url(folder, shareable: true)} do
      %svg
        %use{href: "#copy_symbol"}
      = t(:copy_link)

    = link_to droom.edit_folder_url(folder), :class => "edit btn", :data => {:action => "popup", :type => "html", :affected => "#folder_#{folder.id}"} do
      %svg
        %use{href: "#edit_symbol"}
      = t(:edit_folder)

    = link_to '#', class: "add btn", id: "upload_to_folder_#{folder.id}", data: {role: "upload-file"} do
      = image_tag 'svg/add.svg', width: 16, height: 16 
      = t(:add_document)

    = link_to droom.new_folder_document_url(folder, view: 'google_doc'), :class => "add btn", :data => {:action => "popup", :type => "html", :affected => "#folder_#{folder.id}"} do
      = image_tag 'svg/add.svg', width: 16, height: 16 
      = t(:add_google_doc)

    = link_to droom.new_folder_document_url(folder, view: 'notion_page'), :class => "add btn", :data => {:action => "popup", :type => "html", :affected => "#folder_#{folder.id}"} do
      = image_tag 'svg/add.svg', width: 16, height: 16 
      = t(:add_notion_page)

    = link_to droom.new_folder_folder_url(folder), :class => "add btn", :data => {:action => "popup", :type => "html", :affected => "#folder_#{folder.id}"} do
      = image_tag 'svg/add.svg', width: 16, height: 16 
      = t(:add_subfolder)

    = link_to droom.move_folder_folder_url(folder), :class => "edit btn", :id => "move_folder_#{folder.id}", :data => {:action => "popup", :type => "html", :affected => "#folders"} do
      %svg
        %use{href: "#edit_symbol"}
      = t(:move_folder)

    = link_to droom.folder_url(folder), :method => 'delete', :class => 'delete btn', :data => {:action => "remove", :removed => "#folder_#{folder.id}", :confirm => t(:confirm_delete_folder, :path => folder.path)} do
      %svg
        %use{href: "#trash_symbol"}
      = t(:delete_folder)
