- if can? :edit, folder
  .menu{:data =>{:for => "folder_#{folder.id}"}}
    %ul.actions
      %li
        = link_to 'javascript:void(0)', :class => "copy add", :id => "copy_folder_#{folder.id}", data: {:action => 'copy', :clipboard_text => droom.folder_url(folder, shareable: true)} do
          %svg
            %use{href: "#copy_symbol"}
          = t(:copy_link)
      %li
        = link_to droom.edit_folder_url(folder), :class => "edit", :data => {:action => "popup", :type => "html", :affected => "#folder_#{folder.id}"} do
          %svg
            %use{href: "#edit_symbol"}
          = t(:edit_folder)
      %li
        = link_to '#', class: "add", id: "upload_to_folder_#{folder.id}", data: {role: "upload-file"} do
          %svg
            %use{href: "#add_symbol"}
          = t(:add_document)
      - unless @skip_gdoc_menu
        %li
          = link_to droom.new_folder_document_url(folder, view: 'google_doc'), :class => "add", :data => {:action => "popup", :type => "html", :affected => "#folder_#{folder.id}"} do
            %svg
              %use{href: "#add_symbol"}
            = t(:add_google_doc)
        %li
          = link_to droom.new_folder_document_url(folder, view: 'notion_page'), :class => "add", :data => {:action => "popup", :type => "html", :affected => "#folder_#{folder.id}"} do
            %svg
              %use{href: "#add_symbol"}
            = t(:add_notion_page)
      %li
        = link_to droom.new_folder_folder_url(folder), :class => "add", :data => {:action => "popup", :type => "html", :affected => "#folder_#{folder.id}"} do
          %svg
            %use{href: "#add_symbol"}
          = t(:add_subfolder)
      %li
        = link_to droom.move_folder_folder_url(folder), :class => "edit", :id => "move_folder_#{folder.id}", :data => {:action => "popup", :type => "html", :affected => "#folders"} do
          %svg
            %use{href: "#edit_symbol"}
          = t(:move_folder)
      %li
        = link_to droom.folder_url(folder), :method => 'delete', :class => 'delete', :data => {:action => "remove", :removed => "#folder_#{folder.id}", :confirm => t(:confirm_delete_folder, :path => folder.path)} do
          %svg
            %use{href: "#trash_symbol"}
          = t(:delete_folder)
      - if folder.populated?
        / %li
        /   = link_to t(:download_folder), droom.folder_url(folder, :zip), :class => 'download'
