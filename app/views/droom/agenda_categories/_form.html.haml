.standard-modal-overlay.active
  .standard-modal-container.active
    = form_for [droom, @event, @agenda_category], :html => {:class => 'edit agenda_category'} do |f|
      .standard-modal-header
        .standard-modal-close-btn.cursor-pointer
          %svg.standard_close_icon
            %use{"xlink:href" => "#standard_close_symbol"}
        %svg.logo
          %use{"xlink:href" => "#croucher_logo"}
        .container
          %h2
            = t title

      .standard-modal-body
        .container
          .inputs
            %p.category
              %span#existing_category{:data => {:action => "alternate", :selector => "#new_category"}}
                = f.select :category_id, Droom::Category.for_selection
                %br
                %span.action
                  = link_to t(:add_category), '#', :class => "add"

              %span#new_category
                - @category = Droom::Category.new
                = f.fields_for :category, @category do |ncf|
                  = ncf.text_field :name
                  %br
                  %span.action
                    = link_to t(:existing_category), '#', :class => "revert"

            %p.stretcher
            
      .standard-modal-footer
        .buttons
          = link_to t(:cancel_edit), '#', :class => 'cancel submit-button'
          = f.submit t(:save_agenda_category), class: 'croucher-standard-btn inline'
