- if can? :edit, organisation
  .menu{:data => {:for => "organisation_#{organisation.id}"}}
    %ul.actions
      %li
        = link_to droom.edit_organisation_url(organisation, view: "quick"), :class => 'edit', :data => {:action => "popup", :affected => "#organisation_#{organisation.id}"} do
          %svg
            %use{href: "#edit_symbol"}
          = t(:quick_edit)
      / %li
      /   = link_to t(:edit), droom.edit_organisation_url(organisation, view: "full"), :class => 'edit', :data => {:action => "popup", :affected => "#organisation_#{organisation.id}"}
      %li
        = link_to droom.new_organisation_user_url(organisation), :class => 'add', :data => {:action => "popup", :affected => "#organisation_#{organisation.id}"} do
          %svg
            %use{href: "#add_symbol"}
          = t(:add_user)
      %li
        = link_to droom.edit_organisation_url(organisation, view: "subsume"), :class => 'delete', :data => {:action => "popup", :affected => "#organisations"} do
          %svg
            %use{href: "#trash_symbol"}
          = t(:subsume_organisation)
      %li
        = link_to droom.organisation_url(organisation), :method => 'delete', :class => 'delete', :data => {:action => "remove", :removed => "#organisation_#{organisation.id}", :confirm => t(:confirm_delete_organisation, :name => organisation.name)} do
          %svg
            %use{href: "#trash_symbol"}
          = t(:delete_organisation)
