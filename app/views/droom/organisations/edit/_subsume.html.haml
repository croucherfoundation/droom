- organisation ||= @organisation
- title = t(:subsume_organisation)

#edit_organisation
  .standard-modal-overlay.active
    .standard-modal-container.active
      = form_for [droom, organisation], url: merge_organisation_url(organisation), method: 'put', html: {:class => 'edit organisation'} do |f|
        .standard-modal-header
          .standard-modal-close-btn.cursor-pointer
            %svg.standard_close_icon
              %use{"xlink:href" => "#standard_close_symbol"}
          %svg.logo
            %use{"xlink:href" => "#croucher_logo"}
        .standard-modal-body
          .container
            %h2
              = title
            .inputs
              %p
                You are about to transfer all the users, assets and history of
                %strong
                  = organisation.name
                into the organisation you choose below. Please be careful: the
                = organisation.name
                organisation will vanish completely and its users will have a new affiliation.

              %p.organisation
                = f.label :other_id
                = f.select :other_id, Droom::Organisation.for_selection_with_owner(true)

        .standard-modal-footer
          .buttons
            = link_to t(:cancel_edit), '#', :class => 'cancel submit-button'
            = f.submit t(:subsume_organisation), class: 'croucher-standard-btn inline'
